# Model artifacts
EMOTION_MODEL_PATH=./emotion_model.keras
EMOTION_CLASS_NAMES_PATH=./class_names.npy

# Browser origins allowed by HTTP CORS and WebSocket origin checks
EMOTION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Incoming frame limits
EMOTION_MAX_FRAME_BYTES=2500000
EMOTION_MAX_FRAME_DIMENSION=1280

# Accuracy mode (TTA is slower)
EMOTION_TTA=false

# TensorFlow CPU threads. Benchmarked default for this 16-logical-core machine.
# Set either value to 0 to let TensorFlow choose automatically.
EMOTION_TF_INTRA_OP_THREADS=4
EMOTION_TF_INTER_OP_THREADS=1

# Local SQLite session summaries (raw images are never stored)
EMOTION_DATABASE_PATH=./data/emotion_sessions.db
